{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "ClipGo",
  "version": "1.3.0",
  "default_locale": "en",
  "description": "__MSG_appDescription__",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging", "storage", "contextMenus", "cookies", "notifications", "activeTab"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.instagram.com/*",
    "*://*.bilibili.com/*",
    "*://b23.tv/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.xiaohongshu.com/*",
    "*://*.xhslink.com/*",
    "*://*.tiktok.com/*",
    "*://*.douyin.com/*",
    "*://v.qq.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.douyin.com/*"],
      "js": ["douyin-media.js", "douyin-page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.bilibili.com/*",
        "*://*.x.com/*", "*://*.twitter.com/*", "*://*.xiaohongshu.com/*",
        "*://*.tiktok.com/*", "*://*.douyin.com/*", "*://v.qq.com/*"
      ],
      "js": ["common.js", "douyin-media.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ClipGo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
